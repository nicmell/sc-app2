{
  "tag": "sc-scope",
  "category": "widget",
  "attrs": {
    "bus": {
      "$comment": [
        "the tap trio is the SUBSCRIPTION identity — no re-tap machinery yet",
        "default 0: SuperDirt sums all orbits to the stereo master out (bus 0/1)"
      ],
      "type": "integer",
      "min": 0,
      "default": 0,
      "runtime": false
    },
    "channels": {
      "$comment": "default 2: the stereo master",
      "type": "integer",
      "min": 1,
      "default": 2,
      "runtime": false
    },
    "frames": {
      "$comment": [
        "default 1024 frames = one chunk = the visible window (~21 ms at 48 kHz)",
        "max 16384: ScopeOut2 allocates the slot at maxFrames from scsynth's finite SHM pool, and past this the page-flip refresh (sampleRate/frames) is too slow to read as motion (~3 Hz at 48 kHz)"
      ],
      "type": "integer",
      "min": 1,
      "max": 16384,
      "default": 1024,
      "runtime": false
    },
    "trigger": {
      "$comment": "The former _trigger getter default.",
      "type": "enum",
      "values": ["auto", "normal", "off"],
      "default": "auto"
    },
    "slope": {
      "$comment": "The former _slope getter default.",
      "type": "enum",
      "values": ["rising", "falling"],
      "default": "rising"
    },
    "level": {
      "$comment": "The former _level getter default.",
      "type": "decimal",
      "default": 0
    },
    "gain": {
      "$comment": "The former _gain getter default.",
      "type": "decimal",
      "exclusiveMin": 0,
      "default": 1
    },
    "layout": {
      "$comment": "The former _layout getter default.",
      "type": "enum",
      "values": ["overlay", "split"],
      "default": "overlay"
    },
    "range": {
      "$comment": [
        "Display mapping: `bipolar` (default) draws ±1 around the band middle;",
        "`unipolar` maps [0, 1] bottom→top — envelopes/control taps fill the",
        "lane instead of squashing into the upper half.",
        "The former _range getter default."
      ],
      "type": "enum",
      "values": ["bipolar", "unipolar"],
      "default": "bipolar"
    }
  }
}
