      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="trigger">
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:enumeration value="auto"/>
          <xs:enumeration value="normal"/>
          <xs:enumeration value="off"/>
