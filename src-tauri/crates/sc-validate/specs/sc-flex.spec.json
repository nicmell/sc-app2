    "wrap": { "type": "boolean" },
    "justify": {
      "type": "enum",
      "values": ["start", "center", "end", "space-between", "space-around", "space-evenly"]
    },
    "align": { "type": "enum", "values": ["start", "center", "end", "stretch", "baseline"] },
    "gap": { "type": "enum", "values": ["none", "xs", "sm", "md", "lg"] }
  },
  "content": { "choice": ["blockContent"], "mixed": true }
