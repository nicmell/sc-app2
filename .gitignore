# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Turborepo cache
.turbo

# The one non-submodule dep: sc3-plugins is a prebuilt binary release,
# fetched by `yarn deps` (the source deps are pinned git submodules).
/deps/sc3-plugins

# Yarn
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
/tmp

# SCDoc scraper raw-HTML cache (regenerated by scripts/scdoc/*)
scripts/scdoc/.cache/
/.agents
/.skills

# The repo-local app root (dev scripts point SC_APP_DIR here): runtime data
# only — the versioned dev config stays.
appdir/*
!appdir/config.json
