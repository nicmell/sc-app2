{
  "tag": "sc-scope",
  "category": "widget",
  "attrs": {
    "bus": {
      "$comment": [
        "the tap trio is the SUBSCRIPTION identity — no re-tap machinery yet",
        "SCOPE_INPUT_BUS is 0; specs stay pure JSON, so keep the literal here."
      ],
      "type": "integer",
      "min": 0,
      "default": 0,
      "runtime": false
    },
    "channels": {
      "$comment": "SCOPE_CHANNELS is 2; specs stay pure JSON, so keep the literal here.",
      "type": "integer",
      "min": 1,
      "default": 2,
      "runtime": false
    },
    "frames": {
      "$comment": [
        "SCOPE_CHUNK_SIZE is 1024; specs stay pure JSON, so keep the literal here.",
        "16384 is SCOPE_MAX_FRAMES; specs stay pure JSON, so keep the literal here."
      ],
      "type": "integer",
      "min": 1,
      "max": 16384,
      "default": 1024,
      "runtime": false
    },
    "trigger": {
      "$comment": "The former _trigger getter default.",
      "type": "enum",
      "values": ["auto", "normal", "off"],
      "default": "auto"
    },
    "slope": {
      "$comment": "The former _slope getter default.",
      "type": "enum",
      "values": ["rising", "falling"],
      "default": "rising"
    },
    "level": {
      "$comment": "The former _level getter default.",
      "type": "decimal",
      "default": 0
    },
    "gain": {
      "$comment": "The former _gain getter default.",
      "type": "decimal",
      "exclusiveMin": 0,
      "default": 1
    },
    "layout": {
      "$comment": "The former _layout getter default.",
      "type": "enum",
      "values": ["overlay", "split"],
      "default": "overlay"
    },
    "range": {
      "$comment": [
        "Display mapping: `bipolar` (default) draws ±1 around the band middle;",
        "`unipolar` maps [0, 1] bottom→top — envelopes/control taps fill the",
        "lane instead of squashing into the upper half.",
        "The former _range getter default."
      ],
      "type": "enum",
      "values": ["bipolar", "unipolar"],
      "default": "bipolar"
    }
  }
}
